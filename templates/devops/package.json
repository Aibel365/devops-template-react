{
    "name": "devops-template-react",
    "version": "1.0.0",
    "private": true,
    "description": "Tanstack template for devops web apps",
    "license": "ISC",
    "author": "",
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "main": "eslint.config.js",
    "directories": {
        "test": "tests"
    },
    "scripts": {
        "dev": "vite dev --port 3000",
        "generate-routes": "tsr generate",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint",
        "format": "prettier --write . && eslint --fix",
        "check": "prettier --check .",
        "test": "vitest run",
        "knip": "knip",
        "prepare": "husky",
        "release": "conventional-changelog",
        "docker:build": "docker build . -t preview",
        "docker:run": "docker run -p 3070:8080 -d preview",
        "update": "npx @tanstack/cli@latest create --template https://raw.githubusercontent.com/Aibel365/devops-template-react/refs/heads/main/templates/devops/template.json --non-interactive .",
        "compile": "rimraf template.json start.json && npx @tanstack/cli@latest template compile"
    },
    "dependencies": {
        "@aibel365/devops-designsystem": "^1.19.0",
        "@azure/msal-browser": "^4.30.0",
        "@azure/msal-react": "^3.0.29",
        "@microsoft/applicationinsights-web": "^3.4.3",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-devtools": "latest",
        "@tanstack/react-form": "latest",
        "@tanstack/react-form-devtools": "latest",
        "@tanstack/react-query": "latest",
        "@tanstack/react-query-devtools": "latest",
        "@tanstack/react-router": "latest",
        "@tanstack/react-router-devtools": "latest",
        "@tanstack/react-router-ssr-query": "latest",
        "@tanstack/react-start": "latest",
        "@tanstack/react-store": "latest",
        "@tanstack/store": "latest",
        "axios": "^1.19.0",
        "i18next": "^26.4.0",
        "i18next-browser-languagedetector": "^8.2.1",
        "nitro": "3.0.260610-beta",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-i18next": "^17.0.12",
        "tailwindcss": "^4.3.2",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@tanstack/devtools-event-client": "latest",
        "@tanstack/devtools-vite": "latest",
        "@tanstack/eslint-config": "latest",
        "@tanstack/router-cli": "^1.167.21",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^6.1.0",
        "conventional-changelog": "^8.1.3",
        "eslint": "^9.39.5",
        "husky": "^9.1.7",
        "jsdom": "^28.1.0",
        "knip": "^6.32.2",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.2",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "lightningcss"
        ]
    }
}
